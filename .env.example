# =============================================================================
# DreamTouch Experience #001 — THE UNKNOWN
# Copier ce fichier en ".env" et renseigner les vraies valeurs.
# NE JAMAIS committer le fichier ".env" reel.
# =============================================================================

# --- Base de donnees -----------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/dreamtouch?schema=public"

# --- Application -----------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Paiement Celtis ---------------------------------------------------------
# Voir README.md > "Configuration Celtis" pour la liste exacte des elements
# officiels a demander a Celtis avant de passer en production.
CELTIS_API_KEY=""
CELTIS_SECRET_KEY=""
CELTIS_MERCHANT_ID=""
CELTIS_PAYMENT_URL=""
CELTIS_WEBHOOK_SECRET=""

# Mode de paiement actif: "mock" (sandbox interne, aucun appel reseau reel)
# ou "celtis" (integration reelle, necessite les 5 variables ci-dessus).
PAYMENT_PROVIDER="mock"

# --- Email (SMTP) ------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="DreamTouch Experience <no-reply@dreamtouch.example>"

# --- Administration ------------------------------------------------------------
ADMIN_EMAIL="admin@dreamtouch.example"
ADMIN_PASSWORD="change-me-before-seeding"
JWT_SECRET="replace-with-a-long-random-string"

# --- Divers ------------------------------------------------------------------
# Duree de validite (minutes) d'une reservation PENDING_PAYMENT avant expiration
RESERVATION_TTL_MINUTES="20"

# --- Paiement Kkiapay (Mobile Money / carte, Benin) ---------------------------
PAYMENT_PROVIDER="kkiapay"
NEXT_PUBLIC_KKIAPAY_PUBLIC_KEY=""
KKIAPAY_PRIVATE_KEY=""
KKIAPAY_SECRET_KEY=""
NEXT_PUBLIC_KKIAPAY_SANDBOX="true"